# iShop — production settings for FastComet (shared cPanel hosting).
#
# On the server: copy this file to `.env` in the project folder, fill in the
# values marked CHANGE, then run `php artisan key:generate --force`.
# Never commit the real .env and never send its passwords in chat or email.

APP_NAME=iShop
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# CHANGE: the store address, with https://
APP_URL=https://shop.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Errors go to storage/logs/laravel-YYYY-MM-DD.log, kept 14 days.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# CHANGE: the database and user created in cPanel > MySQL Databases.
# cPanel adds your account prefix to both names (e.g. abcd_ishop).
DB_CONNECTION=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_ishop
DB_USERNAME=cpaneluser_ishop
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Session cookie only over HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Product photos are stored on the public disk (public/storage link).
MEDIA_DISK=public
# Background jobs (photo conversions, mail): run by the every-minute cron.
QUEUE_CONNECTION=database

CACHE_STORE=database

# Send HTTP visitors to HTTPS. Set to false only if the site is behind a
# proxy (e.g. Cloudflare "Flexible") and you see a redirect loop.
FORCE_HTTPS=true

# CHANGE: an email account created in cPanel > Email Accounts
# (password reset, email verification, order emails).
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.example.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# iShop
# CHANGE: the first super-admin, created by `php artisan db:seed --force`.
# Use a strong password (12+ chars, upper/lower case, number, symbol), then
# delete ISHOP_ADMIN_PASSWORD from this file once you have signed in.
ISHOP_ADMIN_EMAIL=
ISHOP_ADMIN_PASSWORD=
# The admin panel asks for two-factor authentication before letting staff in.
ISHOP_ADMIN_REQUIRES_2FA=true

# Paymob (online card / wallet payments): added in a later release.
